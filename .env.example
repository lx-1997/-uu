OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
OPENAI_API_KEY=replace-me
OPENAI_MODEL=qwen3.5-plus
PORT=8787

# SSO 会话 Cookie 有效期（毫秒），默认 14 天；会话内容会写入数据目录 sso-sessions.json，重启后端仍可用同一 Cookie 登录
# SSO_SESSION_MAX_AGE_MS=1209600000

# SSO（默认开启登录门禁；设为 0 关闭）
# 桌面端：SSO 通过 redirectUrl 环回 access_token，由 /api/sso/bootstrap 校验 userinfo 建会话，可不配 CLIENT。
# 纯浏览器内嵌若需授权码回调，须配置 OAuth 客户端与回调 URL。
# SSO_REQUIRED=0
# SSO_BASE_URL=https://sso.d-robotics.cc
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=