# 大模型：RDKClaw 主链路优先级为 ① 设置页 → ~/.rdkstudio/agent-config.json ② 冷启动 config/rdkclaw-provider.defaults.json 或 RDK_PROVIDER_BOOTSTRAP_FILE ③ 下方 OPENAI_* 兜底（及部分旧接口）。改默认模型请改 ①/②，不必再跟 .env 里的 qwen 模板。
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
OPENAI_API_KEY=replace-me
OPENAI_MODEL=doubao-seed-2.0-lite
PORT=8787

# 技能注册表（Skill 工坊「SkillHub」Tab 搜索/下载 SKILL.md；与 https://skillhub.tencent.com 同源数据，默认国内镜像）
# 勿填 skillhub.tencent.com（该域对 API 会回退 SPA）；直连海外可改为 https://clawhub.ai
# CLAWHUB_REGISTRY=https://lightmake.site

# 桌面端内嵌浏览器抓取（无需 Playwright）：Agent 工具 studio_embedded_browser_capture；团队允许域名见仓库 config/studio-browser-capture.json

# 无头浏览器抓取（可选）：需先 npx playwright install chromium；启用后 Agent 可使用 web_browser_fetch（JS 渲染页，比 web_fetch 更重）
# BROWSER_FETCH_ENABLED=1
# 导航完成后再等待的毫秒数（给 Next/SPA 注水），默认 4500
# BROWSER_FETCH_EXTRA_WAIT_MS=6000
# 调试时可开真窗口（非无头），默认无头
# BROWSER_FETCH_HEADED=0
# 可选：逗号分隔主机后缀白名单；不填则仅做 SSRF（禁内网）校验
# BROWSER_FETCH_HOST_ALLOWLIST=developer.d-robotics.cc,example.com

# Tavily（可选，RDKClaw PC 侧按需）：① web_search 在「必应→百度→DuckDuckGo」均无命中后再走 Tavily ② web_fetch 对地瓜 NodeHub 等壳页可自动 Extract（advanced，计费见 Tavily 文档）
# 控制台：https://app.tavily.com/home — 密钥请仅放本机/安装器注入，勿提交 Git
# TAVILY_API_KEY=
# 置 1 时改为 Tavily 优先，再走免费多源（仍须有 TAVILY_API_KEY）
# WEB_SEARCH_TAVILY_FIRST=0

# SSO 会话 Cookie 有效期（毫秒），默认 14 天；会话内容会写入数据目录 sso-sessions.json，重启后端仍可用同一 Cookie 登录
# SSO_SESSION_MAX_AGE_MS=1209600000

# SSO（默认开启登录门禁；设为 0 关闭）
# 桌面端：SSO 通过 redirectUrl 环回 access_token，由 /api/sso/bootstrap 校验 userinfo 建会话，可不配 CLIENT。
# 纯浏览器内嵌若需授权码回调，须配置 OAuth 客户端与回调 URL。
# SSO_REQUIRED=0
# SSO_BASE_URL=https://sso.d-robotics.cc
# SSO_CLIENT_ID=
# SSO_CLIENT_SECRET=

# 行为埋点（单线：POST /api/analytics/events → 本地 JSONL → 可选转发云端）
# 本地主路径：默认 RDK_DATA_DIR 或 ~/.rdk-studio/data/analytics-events.jsonl
# 可改为主写到用户工作区，例如：RDK_ANALYTICS_JSONL_PATH=C:/path/to/project/.rdk-studio/analytics-events.jsonl
# RDK_ANALYTICS_JSONL_PATH=
# 可选镜像第二份（同内容双写）
# RDK_ANALYTICS_JSONL_MIRROR=
# 云端：收到与客户端相同的 JSON 体（schema / clientSessionId / consent / events），自行接入 OSS/数仓
# ANALYTICS_CLOUD_WEBHOOK_URL=https://your-api.example.com/rdk/analytics/ingest
# ANALYTICS_CLOUD_WEBHOOK_SECRET=
# 飞书群机器人：URL 填 open.feishu.cn/.../bot/v2/hook/xxx 即可自动按 text 推送（长内容截断）；Bearer 留空
# 若机器人开启「签名校验」，填飞书后台给出的密钥（不要提交到 Git）
# ANALYTICS_CLOUD_FEISHU_SIGN_SECRET=
# ANALYTICS_CLOUD_FEISHU_WEBHOOK=1
# ANALYTICS_CLOUD_FORWARD_ENABLED=0
# ANALYTICS_INGEST_ENABLED=0
# 前端构建时关闭上报：VITE_ANALYTICS_ENABLED=0
# 埋点请求体加密（与 VITE_ 一致；不配则仍为明文 JSON）
# ANALYTICS_PAYLOAD_SECRET=
# VITE_ANALYTICS_PAYLOAD_SECRET=

# 微信/飞书通道：对「高风险工具」强制先发文字确认（与默认 AI Dock 行为不一致）。默认关闭；需要旧版企业二次确认时设为 1
# RDK_EXTERNAL_FORCE_APPROVAL=1

# 完整对话归档（用户提问 + AI 最终回复）；与匿名埋点分离
# 可选本地 JSONL：CONVERSATION_LOG_ENABLED=1；CONVERSATION_LOG_JSONL_PATH=

# Supabase：对话归档（含 channel / outcome / error_detail；见 supabase/*.sql）
# 凭证优先级：环境变量 > server/supabase-embedded-config.ts 内 SUPABASE_SHIPPING_DEFAULTS（发版写死主路径）> 可选 config/supabase-conversation.embedded.json
# 若需关闭归档：SUPABASE_CONVERSATION_ENABLED=0
# 新库：conversation_turns.sql；已有旧表：先 v3 migrate 再 conversation_turns_migrate_v4_channel_outcome.sql
# SUPABASE_CONVERSATION_ENABLED=0
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SECRET_KEY=（或 SUPABASE_SERVICE_ROLE_KEY）
# SUPABASE_PUBLISHABLE_KEY=（仅当配合 RLS insert policy；不推荐单独用于服务端）
# SUPABASE_CONVERSATION_TABLE=conversation_turns

# Supabase：打开 PV 统计（每次验证/打开一行；已部署旧表需执行 supabase/studio_daily_usage_migrate_pv.sql 去掉每日唯一约束）
# 默认在已配置 SUPABASE_URL + 密钥 时自动写入；设为 0 可关闭
# SUPABASE_DAILY_USAGE_ENABLED=0
# SUPABASE_DAILY_USAGE_TABLE=studio_daily_usage
# 日历日 usage_date 按此时区切分（IANA，默认 Asia/Shanghai）；勿用 UTC 日，否则东八区 0–8 点会记到「前一天」
# SUPABASE_DAILY_USAGE_TIMEZONE=Asia/Shanghai