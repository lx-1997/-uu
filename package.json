{
  "name": "rdk-studio",
  "main": "electron/main.mjs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "desktop": "concurrently \"npm:dev:server\" \"npm:dev:client\" \"npm:electron\"",
    "electron": "node scripts/wait-and-launch.mjs",
    "dev:client": "node scripts/dev-client.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:server && vite build",
    "build:desktop": "npm run build && npm run build:server && electron-builder",
    "build:desktop:win": "npm run build && npm run build:server && electron-builder --win",
    "build:desktop:mac": "npm run build && npm run build:server && electron-builder --mac",
    "build:desktop:linux": "npm run build && npm run build:server && electron-builder --linux",
    "verify:modules": "node scripts/verify-real-modules.mjs",
    "preview": "vite preview",
    "start": "node dist-server/index.js",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "build": {
    "appId": "com.rdk.studio",
    "productName": "RDK Studio",
    "copyright": "Copyright © 2025 RDK",
    "asar": true,
    "asarUnpack": [
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**",
      "node_modules/nan/**"
    ],
    "files": [
      "dist/**",
      "dist-server/**",
      "electron/**",
      "public/**",
      "data/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RDK Studio"
    },
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    }
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@mariozechner/pi-ai": "^0.50.7",
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.6.0",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.16.0",
    "uuid": "^11.1.0",
    "ws": "^8.19.0",
    "xterm": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.8.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
