{
  "name": "rdk-studio",
  "main": "electron/main.mjs",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm:dev:server\" \"npm:dev:client\"",
    "desktop": "concurrently \"npm:dev:server\" \"npm:dev:client\" \"npm:electron\"",
    "electron": "node scripts/wait-and-launch.mjs",
    "dev:client": "node scripts/dev-client.mjs",
    "dev:server": "node scripts/dev-server.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit -p tsconfig.json && npm run build:server && vite build",
    "prepare:build-resources": "node scripts/prepare-build-resources.mjs",
    "clean:win-unpacked": "node scripts/clean-electron-win-unpacked.mjs",
    "build:desktop": "node scripts/build-desktop.mjs win",
    "build:desktop:win": "node scripts/build-desktop.mjs win",
    "build:desktop:win:zip": "node scripts/build-desktop.mjs win zip",
    "build:desktop:win:dir": "node scripts/build-desktop.mjs win dir",
    "build:desktop:mac": "node scripts/build-desktop.mjs mac",
    "build:desktop:linux": "node scripts/build-desktop.mjs linux",
    "verify:desktop:smoke:win": "node scripts/desktop-smoke-check.mjs win",
    "verify:desktop:smoke:mac": "node scripts/desktop-smoke-check.mjs mac",
    "verify:desktop:smoke:linux": "node scripts/desktop-smoke-check.mjs linux",
    "verify:desktop:smoke:summary": "node scripts/smoke-log-summary.mjs",
    "verify:desktop:manifest": "node scripts/release-manifest.mjs",
    "verify:desktop:manifest:guard:linux": "node scripts/release-manifest-guard.mjs linux",
    "verify:desktop:manifest:guard:mac": "node scripts/release-manifest-guard.mjs mac",
    "verify:desktop:manifest:guard:win": "node scripts/release-manifest-guard.mjs win",
    "verify:desktop:baseline:suggest:linux": "node scripts/release-baseline-suggest.mjs linux",
    "verify:desktop:baseline:suggest:mac": "node scripts/release-baseline-suggest.mjs mac",
    "verify:desktop:baseline:suggest:win": "node scripts/release-baseline-suggest.mjs win",
    "verify:desktop:manifest:drift:linux": "node scripts/release-manifest-drift.mjs linux",
    "verify:desktop:manifest:drift:mac": "node scripts/release-manifest-drift.mjs mac",
    "verify:desktop:manifest:drift:win": "node scripts/release-manifest-drift.mjs win",
    "verify:desktop:reference:init:linux": "node scripts/release-reference-sync.mjs linux init",
    "verify:desktop:reference:init:mac": "node scripts/release-reference-sync.mjs mac init",
    "verify:desktop:reference:init:win": "node scripts/release-reference-sync.mjs win init",
    "verify:desktop:reference:update:linux": "node scripts/release-reference-sync.mjs linux update",
    "verify:desktop:reference:update:mac": "node scripts/release-reference-sync.mjs mac update",
    "verify:desktop:reference:update:win": "node scripts/release-reference-sync.mjs win update",
    "verify:modules": "node scripts/verify-real-modules.mjs",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview",
    "start": "node dist-server/server/index.js",
    "build:server": "tsc -p tsconfig.server.json"
  },
  "build": {
    "appId": "com.rdk.studio",
    "productName": "RDK Studio",
    "copyright": "Copyright © 2025 RDK",
    "npmRebuild": false,
    "asar": false,
    "asarUnpack": [
      "node_modules/ssh2/**",
      "node_modules/cpu-features/**",
      "node_modules/nan/**"
    ],
    "files": [
      "dist/**",
      "dist-server/**",
      "electron/**",
      "public/**",
      "config/**",
      "data/**",
      "agent/**",
      "server/resources/**",
      "skills/**",
      "node_modules/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "electron/resources/flash",
        "to": "flash"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RDK Studio"
    },
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    }
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "^5.2.38",
    "@larksuiteoapi/node-sdk": "^1.59.0",
    "@mariozechner/pi-ai": "^0.50.7",
    "@monaco-editor/react": "^4.7.0",
    "@novnc/novnc": "^1.6.0",
    "@supabase/supabase-js": "^2.100.1",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "playwright": "^1.58.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "silk-wasm": "^3.7.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ssh2": "^1.16.0",
    "unpdf": "^1.4.0",
    "uuid": "^11.1.0",
    "ws": "^8.19.0"
  },
  "overrides": {
    "uuid": "$uuid",
    "cacache": {
      "glob": "^13.0.0"
    }
  },
  "devDependencies": {
    "@tencent-weixin/openclaw-weixin": "^2.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.4",
    "chokidar": "^5.0.0",
    "concurrently": "^9.1.2",
    "electron": "^35.1.5",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^1.0.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.1"
  }
}
