{
    "name": "vscode server",
    "type": "interactive shell",
    "needsInstall": true,
    "needsCheck": true,
    "check": {
        "cmd": "hash code-server > /dev/null 2>&1 && echo installed || echo uninstall",
        "keyword": "uninstall"
    },
    "install": [
        "echo 'start installing'",
        "mkdir -p ~/.cache/code-server",
        "curl -#fL -o ~/.cache/code-server/code-server_arm64.deb -C - https://rdkstudio.bj.bcebos.com/appspace/codeserver/code-server_4.96.2_arm64.deb",
        "sudo dpkg -i ~/.cache/code-server/code-server*.deb",
        "rm -f ~/.cache/code-server/code-server*.deb"
    ],
    "uninstall": "sudo dpkg -P code-server",
    "launch": "code-server --auth none --bind-addr 0.0.0.0:9888 --ignore-last-opened",
    "host": "localhost",
    "port": 9888,
    "additional":  {
        "win": "start powershell ssh -N -L localhost:9888:localhost:9888 $user@$ip",
        "mac": "osascript -e 'tell application \"Terminal\" to activate' -e 'tell application \"Terminal\" to do script \"ssh -N -L localhost:9888:localhost:9888 $user@$ip\"'",
        "linux": "gnome-terminal -x bash -c 'ssh -N -L localhost:9888:localhost:9888 $user@$ip'"
    },
    "quit": {

    },
    "description": {
        "zh": "VS Code Server：可以使用Web版本的VS Code查看、编辑远端的代码。",
        "en": "VS Code Server is a service you can run on a remote development machine, like your desktop PC or a virtual machine (VM)."
    },
    "videoTutorial": {
        "zh": "https://www.bilibili.com/video/BV1Y86PYgE78/?share_source=copy_web&vd_source=d7a3dcf73103b07f664eecd90dd4020e",
        "en": "https://www.bilibili.com/video/BV1Y86PYgE78/?share_source=copy_web&vd_source=d7a3dcf73103b07f664eecd90dd4020e"
    }
}