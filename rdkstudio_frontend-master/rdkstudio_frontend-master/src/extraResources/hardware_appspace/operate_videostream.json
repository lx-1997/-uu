{
    "name": "video-stream",
    "type": "interactive shell",
    "needsInstall": true,
    "needsCheck": true,
    "check": {
        "cmd": "hash mjpg_streamer > /dev/null 2>&1 && [ -d ~/.mjpg-streamer ] && [ -d ~/.mjpg-streamer/mjpg-streamer-experimental ] && echo installed || echo uninstall",
        "keyword": "uninstall"
    },
    "install": [
        "echo 'start installing'",
        "sudo apt install libjpeg8-dev imagemagick libv4l-dev cmake -y",
        "[ -d ~/.mjpg-streamer ] || git clone https://gitee.com/ok200/mjpg-streamer.git .mjpg-streamer",
        "[ -d ~/.mjpg-streamer ] || git clone https://github.com/jacksonliam/mjpg-streamer.git .mjpg-streamer",
        "[ -d ~/.mjpg-streamer/mjpg-streamer-experimental ] && (cd ~/.mjpg-streamer/mjpg-streamer-experimental && make && sudo make install)"
    ],
    "uninstall": "sudo rm /usr/local/bin/mjpg_streamer && sudo rm -rf ~/.mjpg-streamer",
    "launch": "mjpg_streamer -i \"$HOME/.mjpg-streamer/mjpg-streamer-experimental/input_uvc.so -d $(media-ctl -p | grep /dev/video | awk 'NR==1{print $NF}') -r 1280x720 -f 15 -n -y\" -o \"$HOME/.mjpg-streamer/mjpg-streamer-experimental/output_http.so -p 20200 -w /usr/local/share/mjpg-streamer/www\"",
    "host": "$ip",
    "port": 20200,
    "params": "action=stream",
    "quit": {

    },
    "description": {
        "zh": "摄像头测试：快速测试摄像头视频",
        "en": "VideoStream: Quick test for USB camera"
    }
}