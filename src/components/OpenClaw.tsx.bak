import { useState, useEffect } from 'react';
import { useAppState } from '../hooks/useAppState';

type InstallState = 'checking' | 'not-installed' | 'installed' | 'running';
type ConfigTab = 'model' | 'feishu' | 'skills' | 'gateway';

const SKILLS = [
  { id: 'device_control', icon: '🕹️', name: '设备控制', desc: '控制 GPIO、LED、舒服电机等硬件', enabled: true },
  { id: 'ros_topic', icon: '📡', name: 'ROS 话题', desc: '查看和发布 ROS2 话题数据', enabled: true },
  { id: 'model_inference', icon: '🧠', name: '模型推理', desc: '调用本地部署的 AI 模型进行推理', enabled: true },
  { id: 'file_transfer', icon: '📦', name: '文件传输', desc: '在本地和设备之间传输文件', enabled: false },
  { id: 'system_info', icon: '🖥️', name: '系统信息', desc: '查看 CPU/Memory/BPU 使用率', enabled: true },
];

export default function OpenClaw() {
  const { addToast, setActiveTab } = useAppState();

  const [installState, setInstallState] = useState<InstallState>('checking');
  const [installing, setInstalling] = useState(false);
  const [starting, setStarting] = useState(false);
  const [configTab, setConfigTab] = useState<ConfigTab>('model');
  const [skillStates, setSkillStates] = useState<Record<string, boolean>>(
    Object.fromEntries(SKILLS.map(s => [s.id, s.enabled]))
  );

  useEffect(() => {
    const timer = setTimeout(() => setInstallState('not-installed'), 1500);
    return () => clearTimeout(timer);
  }, []);

  const handleInstall = () => {
    setInstalling(true);
    addToast('正在安装 OpenClaw... curl -sSL https://openclaw.ai/install.sh | bash', 'info');
    setTimeout(() => {
      setInstalling(false);
      setInstallState('installed');
      addToast('OpenClaw 安装完成！', 'success');
    }, 3000);
  };

  const handleStart = () => {
    setStarting(true);
    addToast('正在启动 OpenClaw 网关服务...', 'info');
    setTimeout(() => {
      setStarting(false);
      setInstallState('running');
      addToast('OpenClaw 网关已启动 (port 8000)', 'success');
    }, 2000);
  };

  const toggleSkill = (id: string) => {
    setSkillStates(prev => ({ ...prev, [id]: !prev[id] }));
  };

  const heroState = () => {
    switch (installState) {
      case 'checking': return { dotClass: 'gray', label: '检测中...' };
      case 'not-installed': return { dotClass: 'red', label: '未安装' };
      case 'installed': return { dotClass: 'yellow', label: '已安装 · 未启动' };
      case 'running': return { dotClass: 'green', label: 'Running' };
    }
  };

  const hs = heroState();

  return (
    <div className="oc-page">
      {/* Hero banner */}
      <div className="oc-hero">
        <div className="oc-hero-row">
          <div className="oc-hero-icon">⚙️</div>
          <div className="oc-hero-body">
            <div className="oc-hero-title">OpenClaw AI 网关</div>
            <div className="oc-hero-desc">
              管理大模型接入、IM 机器人、技能配置与 API 调用监控
            </div>
          </div>
          <div className="oc-hero-badge">
            <span className={`dot ${hs.dotClass}`}></span>
            {hs.label}
          </div>
        </div>

        {installState === 'checking' && (
          <div style={{ marginTop: 16 }}>
            <div className="oc-shimmer"></div>
          </div>
        )}

        {installState === 'not-installed' && (
          <>
            <div className="oc-install-cmd">
              $ curl -sSL https://openclaw.ai/install.sh | bash
            </div>
            <div className="oc-hero-actions">
              <button className="oc-btn primary" onClick={handleInstall} disabled={installing}>
                {installing ? '安装中...' : `${'📥'} 一键安装`}
              </button>
              <button className="oc-btn ghost" onClick={() => addToast('文档: docs.openclaw.ai/zh-CN', 'info')}>
                📖 查看文档
              </button>
            </div>
            {installing && (
              <div className="oc-progress">
                <div className="oc-progress-fill" style={{ width: '65%' }}></div>
              </div>
            )}
          </>
        )}

        {installState === 'installed' && (
          <div className="oc-hero-actions">
            <button className="oc-btn primary" onClick={handleStart} disabled={starting}>
              {starting ? '启动中...' : `▶️ 启动服务`}
            </button>
          </div>
        )}

        {installState === 'running' && (
          <div className="oc-hero-stats">
            <div className="oc-hero-stat">
              <div className="oc-hero-stat-val">8000</div>
              <div className="oc-hero-stat-label">端口</div>
            </div>
            <div className="oc-hero-stat">
              <div className="oc-hero-stat-val">1,247</div>
              <div className="oc-hero-stat-label">今日调用</div>
            </div>
            <div className="oc-hero-stat">
              <div className="oc-hero-stat-val">212ms</div>
              <div className="oc-hero-stat-label">平均延迟</div>
            </div>
            <div className="oc-hero-stat">
              <div className="oc-hero-stat-val">99.8%</div>
              <div className="oc-hero-stat-label">成功率</div>
            </div>
          </div>
        )}
      </div>

      {/* Config section */}
      {(installState === 'installed' || installState === 'running') && (
        <div className="oc-config">
          {/* Quick test bar */}
          {installState === 'running' && (
            <div className="ai-file-bar">
              <div className="ai-file-input-wrap">
                <span className="ai-file-icon">💬</span>
                <input className="clean-input ai-file-input" placeholder="快速测试: 输入一段话让 AI 回复，验证网关连通性" />
              </div>
              <button className="clean-btn" onClick={() => addToast('网关测试请求已发送... 模型响应正常 (212ms)', 'success')}>
                测试
              </button>
            </div>
          )}

          {/* Pill tabs */}
          <div className="oc-tabs">
            {([
              { id: 'model' as ConfigTab, icon: '🤖', label: '模型配置' },
              { id: 'feishu' as ConfigTab, icon: '🐦', label: '飞书机器人' },
              { id: 'skills' as ConfigTab, icon: '🧩', label: '技能配置' },
              { id: 'gateway' as ConfigTab, icon: '🌐', label: '网关监控' },
            ]).map(tab => (
              <button key={tab.id}
                className={`oc-tab ${configTab === tab.id ? 'active' : ''}`}
                onClick={() => setConfigTab(tab.id)}>
                {tab.icon} {tab.label}
              </button>
            ))}
          </div>

          {/* Panel */}
          <div className="oc-panel" style={{ animation: 'fadeIn 0.25s ease' }}>
            {configTab === 'model' && (
              <>
                <h3 className="oc-panel-title">大语言模型 (LLM) 密钥配置</h3>
                <p className="oc-panel-desc">
                  🧠 AI 检测: 当前设备支持本地 Ollama 部署 (4GB 可运行 Qwen2-1.5B)，也可接入云端 API
                </p>
                <div className="oc-field">
                  <label className="oc-label">选择模型提供商</label>
                  <select className="oc-select">
                    <option>OpenAI (或兼容接口如 DeepSeek)</option>
                    <option>阿里云 Qwen (通义千问)</option>
                    <option>本地 Ollama 服务</option>
                  </select>
                </div>
                <div className="oc-field">
                  <label className="oc-label">API 访问地址</label>
                  <input type="text" className="oc-input" defaultValue="https://api.openai.com/v1" />
                </div>
                <div className="oc-field">
                  <label className="oc-label">API 密钥</label>
                  <input type="password" className="oc-input" placeholder="sk-..." />
                </div>
                <div className="oc-field">
                  <label className="oc-label">默认模型</label>
                  <input type="text" className="oc-input" defaultValue="gpt-4" />
                </div>
                <button className="oc-btn primary" style={{ marginTop: 18 }}
                  onClick={() => addToast('模型配置已保存', 'success')}>保存配置</button>
              </>
            )}

            {configTab === 'feishu' && (
              <>
                <h3 className="oc-panel-title">应用集成：飞书 / Telegram 机器人</h3>
                <p className="oc-panel-desc">
                  💡 完成配置后，设备告警、推理结果均可自动推送到飞书群
                </p>
                <div style={{ background: '#f8fafc', padding: '14px 16px', borderRadius: 10, border: '1px solid #e2e8f0', marginBottom: 18 }}>
                  <div style={{ fontWeight: 600, fontSize: '0.88rem', color: '#ff9f0a', marginBottom: 8 }}>
                    步骤 1: 配置请求地址
                  </div>
                  <div style={{ fontFamily: 'monospace', fontSize: '0.84rem', color: '#334155', background: '#f1f5f9', padding: '8px 12px', borderRadius: 6 }}>
                    http://192.168.1.100:8000/api/wechat/lark
                  </div>
                  <div style={{ fontSize: '0.78rem', color: '#64748b', marginTop: 8 }}>
                    复制地址到飞书开放平台 → 事件订阅中验证
                  </div>
                </div>
                <div style={{ fontWeight: 600, fontSize: '0.88rem', color: '#ff9f0a', marginBottom: 12 }}>
                  步骤 2: 绑定 App 凭证
                </div>
                <div style={{ display: 'flex', gap: 12, flexWrap: 'wrap' }}>
                  <div className="oc-field" style={{ flex: 1, minWidth: 150 }}>
                    <label className="oc-label">App ID</label>
                    <input className="oc-input" placeholder="cli_..." />
                  </div>
                  <div className="oc-field" style={{ flex: 1, minWidth: 150 }}>
                    <label className="oc-label">App Secret</label>
                    <input type="password" className="oc-input" placeholder="..." />
                  </div>
                </div>
                <div className="oc-field">
                  <label className="oc-label">Encrypt Key (可选)</label>
                  <input type="password" className="oc-input" placeholder="输入密钥" />
                </div>
                <button className="oc-btn primary" style={{ marginTop: 18 }}
                  onClick={() => addToast('模拟信息已发送到飞书', 'success')}>模拟发送测试卡片</button>
              </>
            )}

            {configTab === 'skills' && (
              <>
                <h3 className="oc-panel-title">技能配置 (Skills)</h3>
                <p className="oc-panel-desc">
                  🧩 技能是 OpenClaw 的核心概念——每个技能定义了 AI 可以调用的一个能力
                </p>
                <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                  {SKILLS.map(skill => (
                    <div key={skill.id} className={`oc-skill ${skillStates[skill.id] ? 'enabled' : ''}`}>
                      <div className="oc-skill-icon">{skill.icon}</div>
                      <div className="oc-skill-body">
                        <div className="oc-skill-name">{skill.name}</div>
                        <div className="oc-skill-desc">{skill.desc}</div>
                      </div>
                      <span className="oc-skill-code">{skill.id}</span>
                      <button className={`oc-toggle ${skillStates[skill.id] ? 'on' : ''}`}
                        onClick={() => toggleSkill(skill.id)} />
                    </div>
                  ))}
                </div>
                <button className="oc-btn ghost" style={{ marginTop: 14, color: '#475569' }}
                  onClick={() => addToast('自定义技能可通过编写 YAML 配置添加', 'info')}>
                  + 添加自定义技能
                </button>
              </>
            )}

            {configTab === 'gateway' && (
              <>
                <h3 className="oc-panel-title">网关监控</h3>
                <div className="oc-metrics" style={{ marginBottom: 18 }}>
                  <div className="oc-metric">
                    <div className="oc-metric-label">网关状态</div>
                    <div className="oc-metric-val" style={{ color: installState === 'running' ? '#30d158' : '#ef4444' }}>
                      {installState === 'running' ? '● Running' : '○ Stopped'}
                    </div>
                  </div>
                  <div className="oc-metric">
                    <div className="oc-metric-label">API 限流</div>
                    <div className="oc-metric-val">120 QPS</div>
                  </div>
                  <div className="oc-metric">
                    <div className="oc-metric-label">今日成功率</div>
                    <div className="oc-metric-val" style={{ color: '#30d158' }}>99.8%</div>
                  </div>
                </div>

                <div style={{ marginBottom: 18 }}>
                  <strong style={{ display: 'block', marginBottom: 10, fontSize: '0.88rem' }}>
                    📊 调用趋势 (最近 6 小时)
                  </strong>
                  <div className="oc-bar-chart">
                    {[42, 65, 88, 120, 95, 78].map((val, i) => (
                      <div key={i} style={{ flex: 1, display: 'flex', flexDirection: 'column', alignItems: 'center' }}>
                        <div className="oc-bar" style={{ height: `${(val / 120) * 56}px` }}></div>
                        <div className="oc-bar-label">{`${i + 5}:00`}</div>
                      </div>
                    ))}
                  </div>
                </div>

                <div>
                  <strong style={{ display: 'block', marginBottom: 10, fontSize: '0.88rem' }}>实时请求日志</strong>
                  <div className="oc-log">
                    <div className="oc-log-line"><span className="ts">[10:45:01]</span> <span className="info">OpenClaw Gateway initialized on port 8000</span></div>
                    <div className="oc-log-line"><span className="ts">[10:45:12]</span> <span className="info">Model Endpoint linked & verified</span></div>
                    <div className="oc-log-line"><span className="ts">[10:46:05]</span> <span className="ok">POST /v1/chat/completions - 200 OK (212ms)</span></div>
                    <div className="oc-log-line"><span className="ts">[10:46:06]</span> <span className="ok">POST /api/wechat/lark - 200 OK (89ms)</span></div>
                  </div>
                </div>
              </>
            )}
          </div>

          {/* Quick links */}
          <div className="oc-links">
            <span className="oc-links-title">🔗 AI 联动</span>
            <button className="chip-btn" onClick={() => setActiveTab('ide')}>✏️ 代码编辑</button>
            <button className="chip-btn" onClick={() => setActiveTab('models')}>🤖 管理推理模型</button>
            <button className="chip-btn" onClick={() => setActiveTab('terminal')}>💻 终端调试</button>
          </div>
        </div>
      )}

      {/* Docs link when not installed */}
      {installState === 'not-installed' && !installing && (
        <div className="oc-panel" style={{ background: '#f8fafc' }}>
          <h3 className="oc-panel-title">📖 了解 OpenClaw</h3>
          <p className="oc-panel-desc" style={{ marginBottom: 0 }}>
            OpenClaw 是地瓜机器人官方的 AI Agent 网关，支持大模型接入、飞书/Telegram 机器人、技能配置等功能。
            详细文档: docs.openclaw.ai/zh-CN
          </p>
        </div>
      )}
    </div>
  );
}
