import { useRef, useEffect, useState } from 'react';
import { useAppState } from '../hooks/useAppState';
import { TERMINAL_PROFILES, COMMAND_SUGGESTIONS } from '../constants';

export default function Terminal() {
  const {
    terminalProfile, setTerminalProfile, terminalDraft, setTerminalDraft,
    terminalSessions, activeSessionId, setActiveSessionId, currentSession,
    createSession, runTerminalCommand, runTerminalAIAnalysis, addToast,
  } = useAppState();

  const screenRef = useRef<HTMLDivElement>(null);
  const inputRef = useRef<HTMLInputElement>(null);
  const [collapsedBlocks, setCollapsedBlocks] = useState<Set<number>>(new Set());

  useEffect(() => {
    if (screenRef.current) screenRef.current.scrollTop = screenRef.current.scrollHeight;
  }, [currentSession.lines]);

  useEffect(() => { inputRef.current?.focus(); }, [activeSessionId]);

  const errorLines = currentSession.lines.filter(l => /error|fail|denied|not found/i.test(l)).length;

  const quickCmds = terminalProfile === 'openclaw'
    ? ['你好，帮我检查设备状态', '列出 ROS 话题', '查看 BPU 使用率', '打开摄像头']
    : COMMAND_SUGGESTIONS;

  // Group lines into Warp-style blocks: command → outputs
  const blocks: { type: 'block' | 'ai'; cmd?: string; lines: string[] }[] = [];
  currentSession.lines.forEach(line => {
    if (line.startsWith('root@') || line.startsWith('$')) {
      blocks.push({ type: 'block', cmd: line, lines: [] });
    } else if (line.startsWith('🤖') || line.startsWith('✨')) {
      blocks.push({ type: 'ai', lines: [line] });
    } else if (line.startsWith('────')) {
      // skip separators
    } else {
      const last = blocks[blocks.length - 1];
      if (last) {
        last.lines.push(line);
      } else {
        blocks.push({ type: 'block', cmd: undefined, lines: [line] });
      }
    }
  });

  const toggleCollapse = (i: number) => {
    setCollapsedBlocks(prev => {
      const next = new Set(prev);
      next.has(i) ? next.delete(i) : next.add(i);
      return next;
    });
  };

  return (
    <div className="term-container warp-term">
      {/* Header */}
      <div className="warp-header">
        <div className="warp-header-left">
          <div className="warp-session-tabs">
            {terminalSessions.map(session => (
              <button key={session.id}
                className={`warp-tab ${activeSessionId === session.id ? 'active' : ''}`}
                onClick={() => setActiveSessionId(session.id)}>
                {session.name}
              </button>
            ))}
            <button className="warp-tab warp-tab-add" onClick={createSession} title="新建会话">+</button>
          </div>
        </div>
        <div className="warp-header-right">
          <select className="warp-mode-select" value={terminalProfile}
            onChange={e => setTerminalProfile(e.target.value)}>
            {TERMINAL_PROFILES.map(p => <option key={p.id} value={p.id}>{p.label}</option>)}
          </select>
          {errorLines > 0 && (
            <button className="warp-warn" onClick={runTerminalAIAnalysis}>⚠ {errorLines} 异常 · AI 分析</button>
          )}
          <button className="warp-icon-btn" title="AI 分析" onClick={runTerminalAIAnalysis}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 015.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          </button>
          <button className="warp-icon-btn" title="清屏" onClick={() => addToast('终端已清屏', 'info')}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6m3 0V4a2 2 0 012-2h4a2 2 0 012 2v2"/></svg>
          </button>
        </div>
      </div>

      {/* Warp-style block area */}
      <div className="warp-blocks" ref={screenRef} onClick={() => inputRef.current?.focus()}>
        {blocks.length === 0 && (
          <div className="warp-empty">
            <div style={{ fontSize: '1.8rem', marginBottom: 10 }}>⚡</div>
            <div style={{ fontWeight: 600, fontSize: '0.95rem', marginBottom: 4 }}>终端就绪</div>
            <div style={{ fontSize: '0.82rem' }}>输入命令或点击快捷按钮开始</div>
          </div>
        )}
        {blocks.map((block, i) => {
          const isCollapsed = collapsedBlocks.has(i);
          const hasErr = block.lines.some(l => /error|fail|denied|not found/i.test(l));

          if (block.type === 'ai') return (
            <div key={i} className="warp-block ai-block">
              <div className="warp-block-content ai">
                {block.lines.map((l, j) => <div key={j}>{l}</div>)}
              </div>
            </div>
          );

          return (
            <div key={i} className={`warp-block ${hasErr ? 'has-err' : ''}`}>
              {block.cmd && (
                <div className="warp-block-cmd" onClick={() => block.lines.length > 0 && toggleCollapse(i)}>
                  <span className="warp-cmd-prompt">$</span>
                  <span className="warp-cmd-text">{block.cmd.replace(/^root@\S+:\S+[#$]\s*/, '')}</span>
                  {block.lines.length > 0 && (
                    <span className="warp-cmd-toggle">{isCollapsed ? `▸ ${block.lines.length} 行` : '▾'}</span>
                  )}
                  {hasErr && <span className="warp-cmd-err-badge">⚠</span>}
                </div>
              )}
              {!isCollapsed && block.lines.length > 0 && (
                <div className="warp-block-output">
                  {block.lines.map((l, j) => {
                    const isErr = /error|fail|denied|not found/i.test(l);
                    return <div key={j} className={`warp-output-line ${isErr ? 'err' : ''}`}>{l}</div>;
                  })}
                </div>
              )}
            </div>
          );
        })}
      </div>

      {/* Quick commands strip */}
      <div className="warp-quick-strip">
        {quickCmds.slice(0, 6).map(cmd => (
          <button key={cmd} className="warp-quick-chip" onClick={() => runTerminalCommand(cmd)}>{cmd}</button>
        ))}
      </div>

      {/* Input area — IDE-style */}
      <div className="warp-input-area">
        <div className="warp-input-row">
          <span className="warp-input-ps1">root@rdk:~$</span>
          <input
            ref={inputRef}
            className="warp-input-field"
            value={terminalDraft}
            onChange={e => setTerminalDraft(e.target.value)}
            placeholder={terminalProfile === 'openclaw' ? '用自然语言描述你想做的事...' : '输入命令...'}
            onKeyDown={e => { if (e.key === 'Enter') { e.preventDefault(); runTerminalCommand(terminalDraft); } }}
            spellCheck={false}
            autoComplete="off"
          />
          <button className="warp-send-btn" onClick={() => runTerminalCommand(terminalDraft)}
            disabled={!terminalDraft.trim()}>
            ↵
          </button>
        </div>
      </div>
    </div>
  );
}
